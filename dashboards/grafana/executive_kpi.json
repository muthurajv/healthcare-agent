{
  "title": "HCSC Agent — Executive KPIs",
  "uid": "hcsc-executive-kpi",
  "tags": ["hcsc", "healthcare", "kpi"],
  "timezone": "browser",
  "refresh": "1m",
  "panels": [
    {
      "id": 1,
      "title": "Total Appointment Requests",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum(traces_spanmetrics_calls_total{span_name=\"find_availability\"})"
      }]
    },
    {
      "id": 2,
      "title": "Booking Success Rate",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              {"color": "red", "value": 0},
              {"color": "yellow", "value": 0.7},
              {"color": "green", "value": 0.9}
            ]
          }
        }
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum(traces_spanmetrics_calls_total{span_name=\"schedule_appointment\",status_code=\"STATUS_CODE_OK\"}) / sum(traces_spanmetrics_calls_total{span_name=\"find_availability\"})"
      }]
    },
    {
      "id": 3,
      "title": "Avg Time to Book (seconds)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "avg(traces_spanmetrics_latency_sum{span_name=\"find_specialist_schedule\"} / traces_spanmetrics_latency_count{span_name=\"find_specialist_schedule\"})"
      }]
    },
    {
      "id": 4,
      "title": "Requests Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 4},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "rate(traces_spanmetrics_calls_total{span_name=\"input_phi_scan\"}[5m])",
        "legendFormat": "Requests/sec"
      }]
    },
    {
      "id": 5,
      "title": "Top Specialties Searched",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "sum by (request_specialty) (traces_spanmetrics_calls_total{span_name=\"search_providers\"})",
        "legendFormat": "{{request_specialty}}"
      }]
    }
  ]
}

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-02-01

# Azure AI Search (provider directory)
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-key>
AZURE_SEARCH_PROVIDER_INDEX=providers

# Azure Health Data Services (FHIR)
FHIR_BASE_URL=https://<your-workspace>.fhir.azurehealthcareapis.com
FHIR_TENANT_ID=<your-tenant-id>
FHIR_CLIENT_ID=<your-client-id>
FHIR_CLIENT_SECRET=<your-client-secret>

# Payer/Eligibility API
PAYER_API_BASE_URL=https://<payer-api-host>/v1
PAYER_API_KEY=<your-payer-api-key>

# Notification service
NOTIFICATION_API_URL=https://<notification-host>/v1/notify
NOTIFICATION_API_KEY=<your-notification-key>

# Consent service
CONSENT_SERVICE_URL=https://<consent-host>/v1/consent

# OpenTelemetry / Grafana
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=hcsc-healthcare-agent
OTEL_SERVICE_VERSION=0.1.0

# App settings
APP_ENV=development
LOG_LEVEL=INFO
